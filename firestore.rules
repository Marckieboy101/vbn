rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSession(data) {
      return data.keys().hasAll(['sessionId', 'timestamp']) &&
             data.sessionId is string &&
             data.timestamp is number;
    }

    // Sessions collection
    match /sessions/{sessionId} {
      allow create: if isValidId(sessionId) && isValidSession(request.resource.data);
      allow get: if true; // Allow reading a session if you know the ID (e.g. for display)
      allow list: if false; // Only admins should list
    }

    // Admin access (Internal mock logic or check specific UID)
    // For this app, we'll allow listing sessions if the user is authenticated as admin
    // In a real app, we'd use a more robust check
    match /sessions/{sessionId} {
      allow read: if request.auth != null; // Simple admin check for this demo environment
    }
  }
}
