rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- ENTITY VALIDATION ---

    function isValidSession(data) {
      return data.keys().hasAll(['sessionId', 'timestamp']) &&
             data.sessionId is string &&
             data.sessionId.size() <= 128 &&
             data.timestamp is number &&
             // Optional fields if present must be correct type
             (!('genres' in data) || data.genres is list) &&
             (!('answers' in data) || data.answers is map) &&
             (!('completed' in data) || data.completed is bool) &&
             (!('thanked' in data) || data.thanked is bool);
    }

    // --- COLLECTIONS ---

    match /sessions/{sessionId} {
      // Allow everyone to create and update sessions for this experience
      allow create: if isValidId(sessionId) && 
                      isValidSession(incoming());
      
      allow update: if isValidId(sessionId) && 
                      isValidSession(incoming());

      // Allow everyone to read sessions (get and list) to fix access issues
      allow read: if true;
      allow list: if true;
    }

    // Admin collection for role lookups (if needed in future)
    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
    }
  }
}
